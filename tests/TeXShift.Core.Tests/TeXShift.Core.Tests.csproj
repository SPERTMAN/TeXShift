<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Stay unsigned: a strong-named test assembly cannot load the unsigned interop
         assembly at runtime, which the contract tests below require. -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unlike the other projects, the interop assembly is referenced with its runtime and
         without type embedding: OneNoteInteropContractTests reflects over TypeLibType/DispId
         attributes that embedded interop types do not carry. -->
    <PackageReference Include="Interop.Microsoft.Office.Interop.OneNote" Version="1.1.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TeXShift.Tests.E2E\RibbonCommandObservation.cs" Link="E2E\RibbonCommandObservation.cs" />
    <Compile Include="..\TeXShift.Tests.E2E\Models\E2ERunReport.cs" Link="E2E\E2ERunReport.cs" />
    <ProjectReference Include="..\..\src\TeXShift.Core\TeXShift.Core.csproj" />
  </ItemGroup>
</Project>
